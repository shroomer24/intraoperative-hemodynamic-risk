/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; connect-src 'self'; font-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; worker-src 'none'; frame-src 'none'; manifest-src 'self'; media-src 'none'
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/demo.html
  Cache-Control: no-cache
/demo
  Cache-Control: no-cache
/demo/
  Cache-Control: no-cache
/404.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/replay-v01/*
  Cache-Control: public, max-age=31536000, immutable
