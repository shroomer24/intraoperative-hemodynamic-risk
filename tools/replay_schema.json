{
  "$comment": "Multi-document schema. Validate each asset against its named $defs entry; no remote references.",
  "$defs": {
    "anchor_status": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "anchor_seconds": {
            "type": "number"
          },
          "frozen_status": {
            "enum": [
              "eligible",
              "ineligible",
              "censored"
            ]
          },
          "query_position": {
            "anyOf": [
              {
                "maximum": 3145,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "retrospective_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "anchor_seconds",
          "frozen_status",
          "retrospective_reason",
          "query_position"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "case_index": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "assets": {
            "additionalProperties": false,
            "properties": {
              "anchor-status": {
                "pattern": "cases/case-0(?:0[1-9]|1[0-9]|2[0-2])/anchor-status\\.json",
                "type": "string"
              },
              "events": {
                "pattern": "cases/case-0(?:0[1-9]|1[0-9]|2[0-2])/events\\.json",
                "type": "string"
              },
              "prediction-windows": {
                "pattern": "cases/case-0(?:0[1-9]|1[0-9]|2[0-2])/prediction-windows\\.json",
                "type": "string"
              },
              "signals": {
                "pattern": "cases/case-0(?:0[1-9]|1[0-9]|2[0-2])/signals\\.json",
                "type": "string"
              }
            },
            "required": [
              "signals",
              "prediction-windows",
              "anchor-status",
              "events"
            ],
            "type": "object"
          },
          "case_ordinal": {
            "pattern": "case-0(?:0[1-9]|1[0-9]|2[0-2])",
            "type": "string"
          },
          "channel_coverage": {
            "additionalProperties": false,
            "properties": {
              "dbp": {
                "$ref": "#/$defs/coverage"
              },
              "etco2": {
                "$ref": "#/$defs/coverage"
              },
              "hr": {
                "$ref": "#/$defs/coverage"
              },
              "map": {
                "$ref": "#/$defs/coverage"
              },
              "sbp": {
                "$ref": "#/$defs/coverage"
              },
              "spo2": {
                "$ref": "#/$defs/coverage"
              }
            },
            "required": [
              "map",
              "hr",
              "spo2",
              "etco2",
              "sbp",
              "dbp"
            ],
            "type": "object"
          },
          "confirmed_episode_count": {
            "minimum": 0,
            "type": "integer"
          },
          "duration_seconds": {
            "minimum": 0,
            "type": "number"
          },
          "evaluable_episode_count": {
            "minimum": 0,
            "type": "integer"
          },
          "grid_start_seconds": {
            "type": "number"
          },
          "grid_step_seconds": {
            "const": 1
          },
          "positive_window_count": {
            "minimum": 0,
            "type": "integer"
          },
          "prediction_window_count": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "case_ordinal",
          "duration_seconds",
          "grid_start_seconds",
          "grid_step_seconds",
          "confirmed_episode_count",
          "evaluable_episode_count",
          "positive_window_count",
          "prediction_window_count",
          "channel_coverage",
          "assets"
        ],
        "type": "object"
      },
      "maxItems": 22,
      "minItems": 22,
      "type": "array"
    },
    "channel": {
      "additionalProperties": false,
      "properties": {
        "age_seconds": {
          "items": {
            "anyOf": [
              {
                "minimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": "array"
        },
        "unit": {
          "enum": [
            "mmHg",
            "beats/min",
            "%"
          ]
        },
        "values": {
          "items": {
            "type": [
              "number",
              "null"
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "unit",
        "values",
        "age_seconds"
      ],
      "type": "object"
    },
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "gap_runs": {
          "minimum": 0,
          "type": "integer"
        },
        "grid_seconds": {
          "minimum": 0,
          "type": "integer"
        },
        "longest_gap_seconds": {
          "minimum": 0,
          "type": "integer"
        },
        "missing_seconds": {
          "minimum": 0,
          "type": "integer"
        },
        "valid_fraction": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "valid_seconds": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "grid_seconds",
        "valid_seconds",
        "missing_seconds",
        "valid_fraction",
        "gap_runs",
        "longest_gap_seconds"
      ],
      "type": "object"
    },
    "events": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "confirmation_seconds": {
            "minimum": 0,
            "type": "number"
          },
          "evaluable": {
            "type": "boolean"
          },
          "is_recurrent": {
            "type": "boolean"
          },
          "minimum_confirmed_low_seconds": {
            "const": 60
          },
          "onset_seconds": {
            "minimum": 0,
            "type": "number"
          },
          "presentation_event_ordinal": {
            "minimum": 1,
            "type": "integer"
          },
          "sustained_duration_seconds": {
            "type": "null"
          }
        },
        "required": [
          "presentation_event_ordinal",
          "onset_seconds",
          "confirmation_seconds",
          "is_recurrent",
          "evaluable",
          "minimum_confirmed_low_seconds",
          "sustained_duration_seconds"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "manifest": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "const": 22
        },
        "generator_source_sha256": {
          "pattern": "[0-9a-f]{64}",
          "type": "string"
        },
        "license_attributions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "changes": {
                "type": "string"
              },
              "doi": {
                "type": "string"
              },
              "license": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "license",
              "source",
              "doi",
              "changes"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "model_lock_sha256": {
          "pattern": "[0-9a-f]{64}",
          "type": "string"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/model"
          },
          "maxItems": 7,
          "minItems": 7,
          "type": "array"
        },
        "prediction_window_count": {
          "const": 3146
        },
        "presentation_files_sha256": {
          "additionalProperties": {
            "pattern": "[0-9a-f]{64}",
            "type": "string"
          },
          "type": "object"
        },
        "probability_source": {
          "const": "sealed TEST outputs"
        },
        "query_order_sha256": {
          "pattern": "[0-9a-f]{64}",
          "type": "string"
        },
        "schema_version": {
          "const": "replay-v01"
        },
        "source_registry_sha256": {
          "pattern": "[0-9a-f]{64}",
          "type": "string"
        },
        "test_completion_receipt_sha256": {
          "pattern": "[0-9a-f]{64}",
          "type": "string"
        },
        "time_basis": {
          "const": "seconds from surgical start"
        }
      },
      "required": [
        "schema_version",
        "model_lock_sha256",
        "test_completion_receipt_sha256",
        "source_registry_sha256",
        "query_order_sha256",
        "generator_source_sha256",
        "time_basis",
        "probability_source",
        "case_count",
        "prediction_window_count",
        "models",
        "license_attributions",
        "presentation_files_sha256"
      ],
      "type": "object"
    },
    "model": {
      "additionalProperties": false,
      "properties": {
        "available_representations": {
          "items": {
            "enum": [
              "raw",
              "calibrated"
            ]
          },
          "type": "array"
        },
        "calibration_provenance": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": "string"
        },
        "feature_count": {
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "enum": [
            "prevalence",
            "current_map",
            "logistic_map",
            "logistic_full",
            "xgboost",
            "tabpfn_map",
            "tabpfn_full"
          ]
        },
        "locked_definition_sha256": {
          "pattern": "[0-9a-f]{64}",
          "type": "string"
        },
        "representation": {
          "enum": [
            "probability",
            "score"
          ]
        }
      },
      "required": [
        "id",
        "display_name",
        "feature_count",
        "representation",
        "available_representations",
        "calibration_provenance",
        "locked_definition_sha256"
      ],
      "type": "object"
    },
    "prediction_windows": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "anchor_seconds": {
            "type": "number"
          },
          "eligible": {
            "const": true
          },
          "future_observation_end_seconds": {
            "type": "number"
          },
          "ground_truth": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "enum": [
                  0,
                  1
                ],
                "type": "integer"
              },
              "matched_episode_onset_seconds": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "label",
              "matched_episode_onset_seconds"
            ],
            "type": "object"
          },
          "history_end_seconds": {
            "type": "number"
          },
          "history_start_seconds": {
            "type": "number"
          },
          "horizon_end_inclusive_seconds": {
            "type": "number"
          },
          "horizon_start_exclusive_seconds": {
            "type": "number"
          },
          "model_outputs": {
            "additionalProperties": false,
            "properties": {
              "current_map": {
                "additionalProperties": false,
                "properties": {
                  "raw_score": {
                    "type": "number"
                  },
                  "score_definition": {
                    "const": "-map_latest"
                  },
                  "unit": {
                    "const": "mmHg"
                  }
                },
                "required": [
                  "raw_score",
                  "score_definition",
                  "unit"
                ],
                "type": "object"
              },
              "logistic_full": {
                "additionalProperties": false,
                "properties": {
                  "calibrated_probability": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "raw_probability": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "raw_probability",
                  "calibrated_probability"
                ],
                "type": "object"
              },
              "logistic_map": {
                "additionalProperties": false,
                "properties": {
                  "calibrated_probability": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "raw_probability": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "raw_probability",
                  "calibrated_probability"
                ],
                "type": "object"
              },
              "prevalence": {
                "additionalProperties": false,
                "properties": {
                  "raw_probability": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "raw_probability"
                ],
                "type": "object"
              },
              "tabpfn_full": {
                "additionalProperties": false,
                "properties": {
                  "calibrated_probability": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "raw_probability": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "raw_probability",
                  "calibrated_probability"
                ],
                "type": "object"
              },
              "tabpfn_map": {
                "additionalProperties": false,
                "properties": {
                  "calibrated_probability": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "raw_probability": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "raw_probability",
                  "calibrated_probability"
                ],
                "type": "object"
              },
              "xgboost": {
                "additionalProperties": false,
                "properties": {
                  "calibrated_probability": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "raw_probability": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "raw_probability",
                  "calibrated_probability"
                ],
                "type": "object"
              }
            },
            "required": [
              "prevalence",
              "current_map",
              "logistic_map",
              "logistic_full",
              "xgboost",
              "tabpfn_map",
              "tabpfn_full"
            ],
            "type": "object"
          },
          "query_position": {
            "maximum": 3145,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "query_position",
          "anchor_seconds",
          "history_start_seconds",
          "history_end_seconds",
          "horizon_start_exclusive_seconds",
          "horizon_end_inclusive_seconds",
          "future_observation_end_seconds",
          "eligible",
          "model_outputs",
          "ground_truth"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "signals": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "additionalProperties": false,
          "properties": {
            "dbp": {
              "$ref": "#/$defs/channel"
            },
            "etco2": {
              "$ref": "#/$defs/channel"
            },
            "hr": {
              "$ref": "#/$defs/channel"
            },
            "map": {
              "$ref": "#/$defs/channel"
            },
            "sbp": {
              "$ref": "#/$defs/channel"
            },
            "spo2": {
              "$ref": "#/$defs/channel"
            }
          },
          "required": [
            "map",
            "hr",
            "spo2",
            "etco2",
            "sbp",
            "dbp"
          ],
          "type": "object"
        },
        "time_seconds": {
          "items": {
            "type": "number"
          },
          "type": "array"
        }
      },
      "required": [
        "time_seconds",
        "channels"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "x-file-definitions": {
    "anchor-status.json": "anchor_status",
    "cases/index.json": "case_index",
    "events.json": "events",
    "manifest.json": "manifest",
    "prediction-windows.json": "prediction_windows",
    "signals.json": "signals"
  }
}
